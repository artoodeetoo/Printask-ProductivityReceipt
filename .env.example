# Copy to .env and fill in. Never commit .env.

# Task sources: configure Notion, Slack, or both
# Notion
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Slack (optional). Bot token (xoxb-...) and comma-separated channel IDs (C...); invite the bot to each channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=
# claude (default): Claude decides which messages are tasks | all | bots (bot posts only) | keyword
SLACK_TASK_MODE=claude
SLACK_KEYWORD=
# Only look at messages from the last N hours; at most N new messages handled per poll
SLACK_LOOKBACK_HOURS=24
SLACK_MAX_PER_CYCLE=10

# Claude priority check. If unset or failing, the Notion priority is used.
# Required when SLACK_TASK_MODE=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Network printer (required). The server must be able to reach PRINTER_HOST:PRINTER_PORT.
PRINTER_HOST=
PRINTER_PORT=9100

# Seconds between polls; 0 runs once and exits
POLL_INTERVAL_SECONDS=300

# Task history database (inside the container; backed by the named volume)
HISTORY_PATH=/data/history.db

# Skip a task whose title matches one printed in the last N days (0 disables)
DEDUPE_WINDOW_DAYS=7

# Old printed.json from earlier versions; imported into the history DB if present
STATE_PATH=/data/printed.json

# Put a QR code linking to the Notion page on each card (set to false to disable)
ENABLE_QR_CODES=true

# Print the Notion Category under the priority dots (set to false to disable)
SHOW_CATEGORY=true

# After printing, set the Notion Priority to match the card (overwrites your own value!).
# Needs the Notion integration's 'Update content' capability. Default off.
NOTION_WRITE_BACK_PRIORITY=false

LOG_LEVEL=INFO

# Web UI: status, history, settings and test buttons. Off unless BOTH are set.
# Pick a long password; it is the only thing protecting the page on your network.
UI_PORT=8081
UI_PASSWORD=
# Where UI-edited settings are saved (they override the values above; secrets never go here)
SETTINGS_PATH=/data/settings.json
